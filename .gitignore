!.env.test
!.env.template
!.env.*.example

# Docker files
!Dockerfile
!Dockerfile.*
!docker-compose.yml
!docker-compose.*.yml
!.dockerignore

# ============================================================================
# ALLOWED: Contents Inside Whitelisted Directories
# ============================================================================
!src/**
!tests/**
!docs/**
!examples/**
!ansible/**
!docker/**
!dbt/**
!.github/**
!.vscode/**


